# ~/.config/cava/config
# output_method = raw is required so Quickshell can parse the bar values
# as a binary stream. The CavaPill.qml subprocess reads this stdout directly.

[general]
framerate = 60
bars = 12              # Number of bars shown in the top bar pill — tune to taste
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pulse
source = auto

[output]
method = raw
# raw_target = /dev/stdout is the default — leave unset.
data_format = binary   # 8-bit values per bar (0–255); simpler to parse than ascii
bit_format = 8bit

# Bar color is set dynamically by the wallpaper-change script via the Quickshell
# QML layer (colors.qml reads from ~/.config/matugen/colors.sh). The color
# setting here is not used in raw mode — it applies only to the built-in terminal
# renderer (output_method = terminal).
[color]
gradient = 0
foreground = '#b4befe'  # Lavender fallback; irrelevant in raw mode but harmless

[smoothing]
monstercat = 0
waves = 0
noise_reduction = 77
