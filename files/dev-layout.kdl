// ~/.config/zellij/layouts/dev-layout.kdl
// Dev layout: three panes.
//   Left (main): full-height terminal — editor or shell.
//   Bottom-right: logs / command output.
//   Top-right: lazygit.
// Triggered by: Super + Shift + Z

layout {
    pane split_direction="vertical" {
        // Left pane: main terminal, takes ~65% of the width.
        pane size="65%" focus=true {
            // Starts an interactive shell. Replace with your editor command
            // if you prefer to land directly in an editor.
        }

        // Right column: split horizontally into two panes.
        pane split_direction="horizontal" size="35%" {
            // Top-right: lazygit.
            pane size="55%" {
                command "lazygit"
            }

            // Bottom-right: logs / command output pane. Starts a shell so
            // you can run tail, docker logs, or any watcher command here.
            pane size="45%" {
            }
        }
    }

    // Status bar at the bottom — shows mode + tab name + session name.
    pane size=1 borderless=true {
        plugin location="zellij:compact-bar"
    }
}
