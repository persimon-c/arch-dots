# Plugin
zinit light zsh-users/zsh-autosuggestions
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions

# fzf keybindings (CTRL+R fuzzy history, CTRL+T fuzzy file search)
source /usr/share/fzf/key-bindings.zsh
source /usr/share/fzf/completion.zsh

# Starship prompt
eval "$(starship init zsh)"

# onefetch on cd into git repos
function chpwd() {
	if git rev-parse --is-inside-work-tree &>/dev/null 2>&1; then
		local obj_count=$(git count-objects | awk '{print $1}')
		if [[ $obj_count -lt 10000 ]]; then
			onefetch
		fi
	fi
}

# History
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS

# fnm
FNM_PATH="/home/simone/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "$(fnm env --shell zsh --use-on-cd)"
fi
alias qs-overview='DRI_PRIME=0 AQ_DRM_DEVICES=/dev/dri/card2 /usr/bin/qs -c overview 2>/dev/null &'
