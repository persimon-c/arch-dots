/* Rofi theme — Catppuccin Mocha base + matugen dynamic accent */
@import "colors.rasi"

* {
    /* Catppuccin Mocha base — hardcoded, never dynamic */
    base:       #1e1e2e;
    mantle:     #181825;
    crust:      #11111b;
    surface0:   #313244;
    surface1:   #45475a;
    overlay0:   #6c7086;
    text:       #cdd6f4;
    subtext1:   #bac2de;
    lavender:   #b4befe;

    background-color:   transparent;
    text-color:         @text;
}

window {
    background-color:   @mantle;
    border:             2px solid;
    border-color:       @accent;
    border-radius:      16px;
    width:              480px;
    padding:            8px;
}

mainbox {
    background-color:   transparent;
    padding:            8px;
    spacing:            8px;
}

inputbar {
    background-color:   @surface0;
    border-radius:      12px;
    padding:            10px 14px;
    spacing:            8px;
    text-color:         @text;
}

prompt {
    text-color: @accent;
}

entry {
    text-color:         @text;
    placeholder-color:  @overlay0;
    placeholder:        "Search...";
}

listview {
    background-color:   transparent;
    lines:              8;
    columns:            1;
    spacing:            4px;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    border-radius:      10px;
    padding:            8px 12px;
    spacing:            8px;
}

element normal.normal {
    background-color:   transparent;
    text-color:         @text;
}

element selected.normal {
    background-color:   @surface0;
    text-color:         @accent;
}

element-icon {
    size:           24px;
}

element-text {
    text-color:     inherit;
}
