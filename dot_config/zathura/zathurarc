# ~/.config/matugen/templates/zathura.conf
# Matugen template — writes ~/.config/zathura/zathurarc on wallpaper change.
# Add your other zathura settings after these color lines.

set default-bg             "#181115"
set default-fg             "#eddfe3"

set statusbar-bg           "#251d21"
set statusbar-fg           "#eddfe3"

set inputbar-bg            "#30282b"
set inputbar-fg            "#eddfe3"

set notification-bg        "#30282b"
set notification-fg        "#eddfe3"
set notification-error-bg  "#ffb4ab"
set notification-error-fg  "#690005"
set notification-warning-bg "#f3ba9b"
set notification-warning-fg "#181115"

set highlight-color        "#6c3454"
set highlight-active-color "#fcb0d6"

set completion-bg          "#251d21"
set completion-fg          "#eddfe3"
set completion-highlight-bg "#fcb0d6"
set completion-highlight-fg "#511d3c"

set recolor                "false"
set recolor-lightcolor     "#181115"
set recolor-darkcolor      "#eddfe3"
